{
  "$schema": "../style.schema.json",
  "name": "graphite",
  "label": "Graphite",
  "medium": "HB pencil on cold-press drawing paper",
  "paper": {
    "texture": "paper",
    "color": "#f3f1ec",
    "grain": 0.35,
    "vignette": 0.12
  },
  "ink": {
    "color": "#2b2a2e",
    "width": 2.0,
    "opacity": 0.88,
    "taper": 0.55,
    "grain": 0.5,
    "jitter": 0.5,
    "blend": "multiply"
  },
  "layers": {
    "shade": {
      "width": 0.55,
      "opacity": 0.5,
      "speed": 0.55
    },
    "contour": {
      "width": 1.25
    }
  },
  "trace": {
    "detail": 0.6,
    "hatch": "crosshatch",
    "hatchDensity": 0.55,
    "levels": 4
  },
  "pen": {
    "tool": "pencil"
  },
  "color": {
    "reveal": "wash",
    "inkAfter": 0.85
  },
  "sound": {
    "kind": "pencil"
  }
}
