#!/usr/bin/env sh
# inkline launcher. Installs nothing on its own: `inkline setup` is the only command that does.
set -e
DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENGINE="$DIR/engine"

if ! command -v node >/dev/null 2>&1; then
  echo "inkline · error: Node.js 18+ is required. Install the LTS from https://nodejs.org and retry." >&2
  exit 1
fi
MAJOR="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$MAJOR" -lt 18 ]; then
  echo "inkline · error: Node.js $MAJOR found; inkline needs 18 or newer." >&2
  exit 1
fi

READY=1
for dep in puppeteer-core @puppeteer/browsers ffmpeg-static; do
  [ -d "$ENGINE/node_modules/$dep" ] || READY=0
done

case "$1" in
  setup)
    if [ "$READY" = 0 ]; then
      echo "inkline · installing the render engine into $ENGINE/node_modules" >&2
      echo "inkline · packages: puppeteer-core, @puppeteer/browsers, ffmpeg-static (about 80 MB, from the npm registry)" >&2
      if [ -f "$ENGINE/package-lock.json" ]; then
        (cd "$ENGINE" && npm ci --omit=dev --no-audit --no-fund --loglevel=error >&2)
      else
        (cd "$ENGINE" && npm install --omit=dev --no-audit --no-fund --loglevel=error >&2)
      fi
    fi
    ;;
  ""|help|-h|--help|-v|--version|doctor|styles|style) ;;
  *)
    if [ "$READY" = 0 ]; then
      echo "inkline · setup required: the render engine is not installed yet." >&2
      echo "inkline · run \`inkline setup\` to install puppeteer-core, @puppeteer/browsers and ffmpeg-static" >&2
      echo "inkline · (about 80 MB, into $ENGINE/node_modules). \`inkline doctor\` shows the details." >&2
      exit 3
    fi
    ;;
esac

exec node "$ENGINE/bin/inkline.js" "$@"
